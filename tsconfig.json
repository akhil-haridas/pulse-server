{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "./src",
        "paths": {
            "@app": [
                "./app.ts"
            ],
            "@prisma": [
                "./models/prisma.ts"
            ],
            "@routes": [
                "./routes/index.ts"
            ],
            "@controllers": [
                "./controllers/index.ts"
            ],
            "@services": [
                "./services/index.ts"
            ],
            "@middlewares": [
                "./middlewares/index.ts"
            ],
            "@models": [
                "./models/index.ts"
            ],
            "@config": [
                "./config/index.ts"
            ],
            "@utils": [
                "./utils/index.ts"
            ],
            "@validations": [
                "./validations/index.ts"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}