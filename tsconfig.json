{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "./src",
        "paths": {
            "@app": [
                "./app.ts"
            ],
            "@routes/*": [
                "./routes/*"
            ],
            "@controllers/*": [
                "./controllers/*"
            ],
            "@services/*": [
                "./services/*"
            ],
            "@middlewares/*": [
                "./middlewares/*"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@config/*": [
                "./config/*"
            ],
            "@utils/*": [
                "./utils/*"
            ],
            "@validations/*": [
                "./validations/*"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}